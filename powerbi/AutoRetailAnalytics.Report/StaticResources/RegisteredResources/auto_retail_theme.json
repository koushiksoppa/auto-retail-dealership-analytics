{
  "name": "Auto Retail Executive",
  "dataColors": ["#2A78D6", "#EB6834", "#1BAF7A", "#EDA100", "#E87BA4", "#008300", "#4A3AA7", "#E34948"],
  "foreground": "#0B0B0B",
  "foregroundNeutralSecondary": "#52514E",
  "foregroundNeutralTertiary": "#8C8B86",
  "background": "#FFFFFF",
  "backgroundLight": "#F5F5F3",
  "backgroundNeutral": "#E4E3DF",
  "tableAccent": "#2A78D6",
  "good": "#1BAF7A",
  "neutral": "#EDA100",
  "bad": "#E34948",
  "maximum": "#1C5CAB",
  "center": "#F0EFEC",
  "minimum": "#E34948",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 14, "color": "#0B0B0B" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 11, "color": "#0B0B0B" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#52514E" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 24, "color": "#0B0B0B" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [{ "show": true, "alignment": "left", "fontSize": 12 }],
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": false }],
        "dropShadow": [{ "show": false }]
      }
    },
    "page": {
      "*": { "background": [{ "color": { "solid": { "color": "#F5F5F3" } }, "transparency": 0 }] }
    }
  }
}
